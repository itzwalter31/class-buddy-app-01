
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model School {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User      @relation("SchoolOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  users    User[]    @relation("UserSchool")
  students Student[]
  classes  Class[]

  @@map("School")
  @@schema("public")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  fullName   String?  @map("full_name")
  schoolName String?  @map("school_name")
  avatarUrl  String?  @map("avatar_url")
  role       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  schoolId   String?  @map("school_id")

  school       School?  @relation("UserSchool", fields: [schoolId], references: [id], onDelete: SetNull)
  ownedSchools School[] @relation("SchoolOwner")

  @@map("users")
  @@schema("public")
}

model Class {
  id        String @id @default(uuid())
  className String @map("name")
  schoolId  String

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  students Student[]

  @@map("Class")
  @@schema("public")
}

model Student {
  id            String    @id @default(uuid())
  studentNumber String   @unique
  firstName     String
  lastName      String
  otherNames    String?
  gender        String?
  dateOfBirth   DateTime?
  schoolId      String
  classId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class      Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  photos     StudentPhoto[]
  attendance Attendance[]

  @@map("Student")
  @@schema("public")
}

model StudentPhoto {
  id              String   @id @default(uuid())
  studentId       String
  imageUrl        String
  embeddingStatus String
  embeddingVector Json?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@map("StudentPhoto")
  @@schema("public")
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  date      DateTime
  status    String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@map("Attendance")
  @@schema("public")
}
