generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model User {
  id           String     @id @default(uuid())
  username     String
  email        String     @unique
 passwordHash String @map("password_hash")
  role         String
  createdAt    DateTime   @default(now()) @map("created_at")
  auditLogs    AuditLog[]

  @@map("users")
@@schema("public")
}

model Class {
  id          String    @id @default(uuid())
  className   String    @map("class_name")
  classTeacher String?  @map("class_teacher")
  createdAt   DateTime  @default(now()) @map("created_at")
  students    Student[]
  attendance  Attendance[]

  @@map("classes")
@@schema("public")
}

model Student {
  id            String         @id @default(uuid())
  studentNumber String         @unique @map("student_number")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  otherNames    String?        @map("other_names")
  gender        String
  dateOfBirth   DateTime       @map("date_of_birth")
  email         String         @unique
  phone         String
  address       String?        
  classId       String?        @map("class_id")
  class         Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  photos        StudentPhoto[]
  attendance    Attendance[]

  @@map("students")
@@schema("public")
}

model StudentPhoto {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  imageUrl        String   @map("image_url")
  imageType       String   @map("image_type")
  embeddingStatus String   @map("embedding_status")
  embeddingVector String?  @map("embedding_vector")
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("student_photos")
@@schema("public")
}

model Attendance {
  id               String   @id @default(uuid())
  studentId        String   @map("student_id")
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId          String?  @map("class_id")
  class            Class?   @relation(fields: [classId], references: [id])
  date             DateTime
  time             DateTime
  status           String
  capturedImage    String?  @map("captured_image")
  confidenceScore  Decimal? @map("confidence_score")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("attendance")
@@schema("public")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
@@schema("public")
}
