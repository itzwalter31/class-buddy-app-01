generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model public_users {
  id          String  @id @db.Uuid
  email       String  @unique
  full_name   String?
  school_name String?
  avatar_url  String?
  role        String? @default("teacher")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  schools School[]

  @@map("users")
  @@schema("public")
}

model School {
  id   String @id @default(uuid())
  name String

  ownerId String       @db.Uuid
  owner   public_users @relation(fields: [ownerId], references: [id])

  classes  Class[]
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Class {
  id   String @id @default(uuid())
  name String

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  students Student[]

  @@schema("public")
}

model Student {
  id String @id @default(uuid())

  studentNumber String @unique

  firstName  String
  lastName   String
  otherNames String?

  gender      String?
  dateOfBirth DateTime?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  photos     StudentPhoto[]
  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model StudentPhoto {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  imageUrl String

  embeddingStatus String @default("pending")
  embeddingVector Json?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@schema("public")
}

model Attendance {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  date   DateTime
  status String

  createdAt DateTime @default(now())

  @@schema("public")
}
